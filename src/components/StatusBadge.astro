---
interface Props {
  status: 'Open' | 'Restricted' | 'Closed';
  lang?: 'en' | 'zh';
}

const { status, lang = 'en' } = Astro.props;

const labels = {
  Open: { en: 'Open', zh: '开放' },
  Restricted: { en: 'Restricted', zh: '受限' },
  Closed: { en: 'Closed', zh: '关闭' },
};

const styles = {
  Open: 'bg-emerald-50 text-emerald-700 border-emerald-200/60',
  Restricted: 'bg-amber-50 text-amber-700 border-amber-200/60',
  Closed: 'bg-red-50 text-red-700 border-red-200/60',
};

const dotStyles = {
  Open: 'bg-emerald-500',
  Restricted: 'bg-amber-500',
  Closed: 'bg-red-500',
};
---

<span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium border ${styles[status]}`}>
  <span class={`w-1.5 h-1.5 rounded-full ${dotStyles[status]}`}></span>
  {labels[status][lang]}
</span>
