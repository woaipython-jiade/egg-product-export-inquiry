---
import { getLangFromUrl, getLocalizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const targetLang = lang === 'en' ? 'zh' : 'en';
const targetLabel = lang === 'en' ? '中文' : 'English';
const targetPath = getLocalizedPath(Astro.url.pathname.replace(/^\/(en|zh)/, ''), targetLang);
---

<a
  href={targetPath}
  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-primary-700 border border-slate-200 rounded-md hover:border-primary-300 transition-colors"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
  </svg>
  {targetLabel}
</a>
