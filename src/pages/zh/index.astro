---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('zh');
const allMarkets = await getCollection('markets', ({ id }) => id.startsWith('zh/'));
const allGuides = await getCollection('guides', ({ id }) => id.startsWith('zh/'));

const statusCounts = {
  Open: allMarkets.filter(m => m.data.status === 'Open').length,
  Restricted: allMarkets.filter(m => m.data.status === 'Restricted').length,
  Closed: allMarkets.filter(m => m.data.status === 'Closed').length,
};
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 -left-20 w-72 h-72 bg-primary-400/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 right-1/3 w-48 h-48 bg-primary-300/5 rounded-full blur-2xl"></div>
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0h60v60H0z' fill='none' stroke='white' stroke-width='0.5'/%3E%3C/svg%3E&quot;);"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="max-w-3xl">
        <p class="text-primary-300 text-sm font-medium tracking-widest uppercase mb-4 animate-fade-up delay-0">
          市场情报平台
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold tracking-tight leading-[1.1] mb-6 animate-fade-up delay-1">
          {t('hero.title')}
        </h1>
        <p class="text-lg sm:text-xl text-primary-100/90 max-w-2xl leading-relaxed animate-fade-up delay-2">
          {t('hero.subtitle')}
        </p>
        <div class="mt-10 flex flex-wrap gap-4 animate-fade-up delay-3">
          <a href="/zh/markets/" class="inline-flex items-center px-7 py-3.5 bg-white text-primary-900 font-semibold rounded-lg hover:bg-primary-50 hover:shadow-lg hover:shadow-white/10 transition-all duration-300 cursor-pointer min-h-[44px]">
            {t('nav.markets')} <span class="ml-2">&rarr;</span>
          </a>
          <a href="/zh/guides/" class="inline-flex items-center px-7 py-3.5 border border-white/25 text-white font-medium rounded-lg hover:bg-white/10 hover:border-white/40 transition-all duration-300 cursor-pointer min-h-[44px]">
            {t('nav.guides')} <span class="ml-2">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Stats row -->
      <div class="mt-16 grid grid-cols-3 gap-6 max-w-md animate-fade-up delay-4">
        <div>
          <div class="text-3xl sm:text-4xl font-display font-bold">{allMarkets.length}</div>
          <div class="text-sm text-primary-300 mt-1">市场</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-display font-bold">{allGuides.length}</div>
          <div class="text-sm text-primary-300 mt-1">指南</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-display font-bold">2</div>
          <div class="text-sm text-primary-300 mt-1">语言</div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-400/30 to-transparent"></div>
  </section>

  <!-- Market Overview -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="reveal">
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-slate-900 mb-2">{t('home.markets.title')}</h2>
      <p class="text-slate-600 mb-10 max-w-2xl">{t('home.markets.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10 reveal" style="transition-delay: 100ms;">
      <div class="relative bg-gradient-to-br from-emerald-50 to-white border border-emerald-200/60 rounded-xl p-6 text-center card-hover">
        <div class="text-4xl font-display font-bold text-status-open">{statusCounts.Open}</div>
        <div class="text-sm text-status-open font-medium mt-2">{t('status.open')}</div>
      </div>
      <div class="relative bg-gradient-to-br from-amber-50 to-white border border-amber-200/60 rounded-xl p-6 text-center card-hover">
        <div class="text-4xl font-display font-bold text-status-restricted">{statusCounts.Restricted}</div>
        <div class="text-sm text-status-restricted font-medium mt-2">{t('status.restricted')}</div>
      </div>
      <div class="relative bg-gradient-to-br from-red-50 to-white border border-red-200/60 rounded-xl p-6 text-center card-hover">
        <div class="text-4xl font-display font-bold text-status-closed">{statusCounts.Closed}</div>
        <div class="text-sm text-status-closed font-medium mt-2">{t('status.closed')}</div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {allMarkets.sort((a, b) => a.data.priority - b.data.priority).map((market, i) => (
        <a
          href={`/zh/markets/${market.data.slug}`}
          class="reveal block border border-slate-200 rounded-xl p-6 hover:border-primary-200 hover:shadow-lg hover:shadow-primary-500/5 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer group bg-white"
          style={`transition-delay: ${(i % 4) * 80}ms;`}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="font-display font-semibold text-lg text-slate-900 group-hover:text-primary-700 transition-colors duration-200">
                {market.data.titleZh}
              </h3>
              <p class="text-sm text-slate-500 mt-1">{market.data.region} &middot; 更新于 {market.data.asOfDate}</p>
            </div>
            <StatusBadge status={market.data.status} lang="zh" />
          </div>
          <p class="text-sm text-slate-600 mt-3 leading-relaxed">{market.data.summaryZh}</p>
          <span class="inline-flex items-center text-sm text-primary-600 font-medium mt-4 group-hover:gap-2 gap-1 transition-all duration-200">
            查看详情 <span>&rarr;</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Guides -->
  <section class="relative border-y border-slate-200/80">
    <div class="absolute inset-0 bg-gradient-to-b from-slate-50 to-white"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <div class="reveal">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-slate-900 mb-2">{t('home.guides.title')}</h2>
        <p class="text-slate-600 mb-10 max-w-2xl">{t('home.guides.subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {allGuides.sort((a, b) => a.data.priority - b.data.priority).map((guide, i) => (
          <a
            href={`/zh/guides/${guide.data.slug}`}
            class="reveal block bg-white border border-slate-200 rounded-xl p-6 hover:border-primary-200 hover:shadow-lg hover:shadow-primary-500/5 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer group"
            style={`transition-delay: ${i * 100}ms;`}
          >
            <div class="flex items-start gap-4">
              <span class="inline-flex items-center justify-center w-10 h-10 bg-primary-100 text-primary-700 rounded-xl flex-shrink-0 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </span>
              <div>
                <h3 class="font-display font-semibold text-lg text-slate-900 group-hover:text-primary-700 transition-colors duration-200">
                  {guide.data.titleZh}
                </h3>
                <p class="text-xs text-primary-600/70 font-medium uppercase tracking-wide mt-1">{guide.data.category}</p>
                <p class="text-sm text-slate-600 mt-2 leading-relaxed">{guide.data.summaryZh}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="reveal max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-slate-900 mb-4">{t('home.about.title')}</h2>
      <p class="text-slate-600 leading-relaxed text-lg">{t('home.about.text')}</p>
    </div>
  </section>
</BaseLayout>
