---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/ui';

const t = useTranslations('zh');

const hsCodes = [
  { code: '0408.11.80', description: '干燥蛋黄，适合人类食用', commercial: '蛋黄粉' },
  { code: '0408.19.81', description: '液态蛋黄', commercial: '液态蛋黄' },
  { code: '0408.19.89', description: '冷冻或以其他方式保存的蛋黄', commercial: '冷冻蛋黄' },
  { code: '0408.91.80', description: '其他蛋（全蛋/蛋白），干燥，适合人类食用', commercial: '全蛋粉 / 蛋白粉' },
  { code: '0408.99.80', description: '其他去壳蛋（液态/冷冻全蛋）', commercial: '液态全蛋 / 液态蛋白' },
  { code: '3502.11', description: '干燥蛋白蛋白', commercial: '干燥蛋白蛋白（工业用）' },
  { code: '3502.19', description: '其他形式蛋白蛋白', commercial: '液态蛋白蛋白（工业用）' },
];
---

<BaseLayout title={t('hscodes.title')}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <div class="mb-10 animate-fade-up">
      <h1 class="text-3xl sm:text-4xl font-display font-bold text-slate-900 mb-3">{t('hscodes.title')}</h1>
      <p class="text-slate-600 max-w-2xl">{t('hscodes.subtitle')}</p>
    </div>

    <!-- Desktop table -->
    <div class="hidden md:block overflow-x-auto reveal rounded-xl border border-slate-200">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b-2 border-slate-200 bg-slate-50/80">
            <th class="py-3.5 px-5 text-sm font-display font-semibold text-slate-900">{t('hscodes.code')}</th>
            <th class="py-3.5 px-5 text-sm font-display font-semibold text-slate-900">{t('hscodes.description')}</th>
            <th class="py-3.5 px-5 text-sm font-display font-semibold text-slate-900">{t('hscodes.commercial')}</th>
          </tr>
        </thead>
        <tbody>
          {hsCodes.map((item, i) => (
            <tr class={`border-b border-slate-100 ${i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}`}>
              <td class="py-3.5 px-5 text-sm font-mono font-medium text-primary-700">{item.code}</td>
              <td class="py-3.5 px-5 text-sm text-slate-700">{item.description}</td>
              <td class="py-3.5 px-5 text-sm text-slate-600">{item.commercial}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile cards -->
    <div class="md:hidden space-y-3">
      {hsCodes.map((item) => (
        <div class="border border-slate-200 rounded-xl p-5 reveal">
          <div class="font-mono text-sm font-medium text-primary-700 mb-2">{item.code}</div>
          <div class="text-sm text-slate-700 mb-1">{item.description}</div>
          <div class="text-xs text-slate-500">{item.commercial}</div>
        </div>
      ))}
    </div>

    <!-- Notes -->
    <div class="mt-10 p-5 bg-gradient-to-br from-slate-50 to-white border border-slate-200 rounded-xl reveal">
      <h2 class="text-sm font-display font-semibold text-slate-900 mb-3">说明</h2>
      <ul class="text-sm text-slate-600 space-y-1.5">
        <li>HS编码可能因国家/地区而异，请务必向目的地海关确认。</li>
        <li>0408.xx范围内的编码为食品级蛋制品，受食品安全法规约束。</li>
        <li>3502.xx范围内的编码为蛋白蛋白产品，可能受不同的监管框架约束（化工/工业 vs. 食品）。</li>
        <li>关税税率取决于目的地国家，可能受优惠贸易协定影响。</li>
      </ul>
    </div>
  </div>
</BaseLayout>
