---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';

const en = ui.en;
const zh = ui.zh;
---

<BaseLayout title={en['notFound.title']}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-24 text-center">
    <h1 class="text-8xl font-display font-bold text-slate-200 mb-4">404</h1>
    <p class="text-xl text-slate-600 mb-4">{en['notFound.message']}</p>
    <p class="text-lg text-slate-500 mb-8">{zh['notFound.message']}</p>
    <div class="flex items-center justify-center gap-4">
      <a
        href="/en/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-primary-700 text-white rounded-lg hover:bg-primary-800 transition-colors duration-200"
      >
        {en['notFound.backHome']}
      </a>
      <a
        href="/zh/"
        class="inline-flex items-center gap-2 px-6 py-3 border border-primary-700 text-primary-700 rounded-lg hover:bg-primary-50 transition-colors duration-200"
      >
        {zh['notFound.backHome']}
      </a>
    </div>
  </div>
</BaseLayout>
