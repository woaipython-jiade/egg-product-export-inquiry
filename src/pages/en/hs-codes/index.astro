---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/ui';

const t = useTranslations('en');

const hsCodes = [
  { code: '0408.11.80', description: 'Egg yolks, dried, fit for human consumption', commercial: 'Egg yolk powder' },
  { code: '0408.19.81', description: 'Egg yolks, liquid', commercial: 'Liquid egg yolk' },
  { code: '0408.19.89', description: 'Egg yolks, frozen or otherwise preserved', commercial: 'Frozen egg yolk' },
  { code: '0408.91.80', description: 'Other eggs (whole/white), dried, fit for human consumption', commercial: 'Whole egg powder / Egg white powder' },
  { code: '0408.99.80', description: 'Other eggs, not in shell (liquid/frozen whole egg)', commercial: 'Liquid whole egg / Liquid egg white' },
  { code: '3502.11', description: 'Egg albumin, dried', commercial: 'Dried egg albumin (industrial)' },
  { code: '3502.19', description: 'Egg albumin, other forms', commercial: 'Liquid egg albumin (industrial)' },
];
---

<BaseLayout title={t('hscodes.title')}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-2">{t('hscodes.title')}</h1>
    <p class="text-slate-600 mb-8">{t('hscodes.subtitle')}</p>

    <!-- Desktop table -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b-2 border-slate-200">
            <th class="py-3 px-4 text-sm font-semibold text-slate-900">{t('hscodes.code')}</th>
            <th class="py-3 px-4 text-sm font-semibold text-slate-900">{t('hscodes.description')}</th>
            <th class="py-3 px-4 text-sm font-semibold text-slate-900">{t('hscodes.commercial')}</th>
          </tr>
        </thead>
        <tbody>
          {hsCodes.map((item, i) => (
            <tr class={`border-b border-slate-100 ${i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}`}>
              <td class="py-3 px-4 text-sm font-mono font-medium text-primary-700">{item.code}</td>
              <td class="py-3 px-4 text-sm text-slate-700">{item.description}</td>
              <td class="py-3 px-4 text-sm text-slate-600">{item.commercial}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile cards -->
    <div class="md:hidden space-y-3">
      {hsCodes.map((item) => (
        <div class="border border-slate-200 rounded-lg p-4">
          <div class="font-mono text-sm font-medium text-primary-700 mb-2">{item.code}</div>
          <div class="text-sm text-slate-700 mb-1">{item.description}</div>
          <div class="text-xs text-slate-500">{item.commercial}</div>
        </div>
      ))}
    </div>

    <!-- Notes -->
    <div class="mt-8 p-4 bg-slate-50 border border-slate-200 rounded-lg">
      <h2 class="text-sm font-semibold text-slate-900 mb-2">Notes</h2>
      <ul class="text-sm text-slate-600 space-y-1">
        <li>HS codes may vary by country. Always confirm with destination customs authority.</li>
        <li>Codes in the 0408.xx range are food-grade egg products subject to food safety regulations.</li>
        <li>Codes in the 3502.xx range are egg albumin products, which may fall under different regulatory frameworks (chemical/industrial vs. food).</li>
        <li>Tariff rates depend on destination country and may be subject to preferential trade agreements.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
