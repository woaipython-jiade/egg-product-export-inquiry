---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/ui';

const t = useTranslations('en');
const allMarkets = await getCollection('markets', ({ id }) => !id.startsWith('zh/'));
---

<BaseLayout title={t('markets.title')}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <div class="mb-10 animate-fade-up">
      <h1 class="text-3xl sm:text-4xl font-display font-bold text-slate-900 mb-3">{t('markets.title')}</h1>
      <p class="text-slate-600 max-w-2xl">{t('markets.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {allMarkets.sort((a, b) => a.data.priority - b.data.priority).map((market, i) => (
        <a
          href={`/en/markets/${market.data.slug}`}
          class="reveal block border border-slate-200 rounded-xl p-6 hover:border-primary-200 hover:shadow-lg hover:shadow-primary-500/5 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer group bg-white"
          style={`transition-delay: ${(i % 4) * 80}ms;`}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-display font-semibold text-slate-900 group-hover:text-primary-700 transition-colors duration-200">
                {market.data.title}
              </h3>
              <p class="text-sm text-slate-500 mt-1">{market.data.region} &middot; Updated {market.data.asOfDate}</p>
            </div>
            <StatusBadge status={market.data.status} lang="en" />
          </div>
          <p class="text-sm text-slate-600 mt-3 leading-relaxed">{market.data.summary}</p>
          <span class="inline-flex items-center text-sm text-primary-600 font-medium mt-4 group-hover:gap-2 gap-1 transition-all duration-200">
            {t('readmore')} <span>&rarr;</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
